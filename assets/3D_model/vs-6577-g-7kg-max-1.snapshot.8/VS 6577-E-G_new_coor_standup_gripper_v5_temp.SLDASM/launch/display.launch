<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find VS 6577-E-G_new_coor_standup_gripper_v5_temp.SLDASM)/urdf/VS 6577-E-G_new_coor_standup_gripper_v5_temp.SLDASM.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find VS 6577-E-G_new_coor_standup_gripper_v5_temp.SLDASM)/urdf.rviz" />
</launch>